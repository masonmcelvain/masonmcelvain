{
   "name": "masonmcelvain",
   "version": "2.0.0",
   "license": "MIT",
   "description": "Portfolio site for Mason McElvain",
   "author": "Mason",
   "repository": {
      "type": "git",
      "url": "https://github.com/masonmcelvain/masonmcelvain"
   },
   "packageManager": "pnpm@11.23.0",
   "engines": {
      "node": "24.20.0"
   },
   "scripts": {
      "dev": "next dev",
      "email:draft": "node --env-file-if-exists=.env.local --import tsx bin/send-post.mts",
      "build": "next build",
      "start": "next start",
      "lint": "eslint .",
      "lint:fix": "eslint . --fix .",
      "format": "prettier --write .",
      "prepare": "husky",
      "typecheck": "tsc --pretty",
      "typegen": "next typegen"
   },
   "dependencies": {
      "@mdx-js/mdx": "3.1.1",
      "@react-email/render": "2.1.0",
      "@sentry/nextjs": "10.70.0",
      "clsx": "2.1.1",
      "embla-carousel-react": "8.6.0",
      "github-slugger": "2.0.0",
      "gray-matter": "4.0.3",
      "next": "16.3.3",
      "next-mdx-remote": "6.0.0",
      "nextjs-toploader": "3.9.17",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "react-icons": "5.7.0",
      "rehype-slug": "6.0.0",
      "resend": "6.22.0",
      "tailwind-merge": "3.6.0"
   },
   "devDependencies": {
      "@eslint/js": "9.39.5",
      "@tailwindcss/postcss": "4.3.3",
      "@tailwindcss/typography": "0.5.20",
      "@types/node": "24.13.3",
      "@types/react": "19.2.18",
      "@typescript-eslint/eslint-plugin": "8.67.0",
      "@typescript-eslint/parser": "8.67.0",
      "eslint": "9.39.5",
      "eslint-config-next": "16.3.3",
      "eslint-config-prettier": "10.1.8",
      "eslint-plugin-jsx-a11y": "6.10.2",
      "husky": "9.1.7",
      "lint-staged": "17.3.0",
      "postcss": "8.5.26",
      "prettier": "3.9.6",
      "prettier-plugin-tailwindcss": "0.8.1",
      "tailwindcss": "4.3.3",
      "tsx": "4.23.12",
      "typescript": "6.0.3",
      "vercel": "59.5.0"
   },
   "lint-staged": {
      "*": "prettier --write --ignore-unknown"
   },
   "nextBundleAnalysis": {
      "budget": 358400,
      "budgetPercentIncreaseRed": 20,
      "minimumChangeThreshold": 0,
      "showDetails": true
   }
}
